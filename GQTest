import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import java.util.Iterator;

/*
 test cases needed from GQ and HM classes
 as well as all three iterators.
 tests are split between two files
 minimum one test per method
 test forEach loop and constructors for GQ and HM
 test descendingIterator
 
 
 */


public class GQTest {

    private GenericQueue<Integer> queue;

    @BeforeEach
    public void setUp() { //runs before each individual method test
        queue = new GenericQueue<>(1); // fresh queue with firstNode = 1
    }

    @Test
    public void testConstructor() {
        assertNotNull(queue); //queue should exist
        assertEquals(1, queue.getLength()); //length should be 1
        assertEquals(1, queue.getHead().data); //head node data should be 1
    }

    @Test
    public void testAdd() {
        queue.add(2); //testing adding a node with value 2 to the back of the list
        assertEquals(2, queue.getLength()); //length should be 2
        assertEquals(1, queue.getHead().data); //head should be still 1
        assertEquals(2, queue.getHead().next.data); //second node should be 2
    }

    @Test
    public void testAddWithCode() {
        queue.add(5, 21); //testing adding with data/code
        assertEquals(2, queue.getLength()); //length should be 2
        assertEquals(5, queue.getHead().next.data); //2nd node data should be 5
        assertEquals(21, queue.getHead().next.code); //2nd node code should be 21
    }
    
    
    @Test
    public void testEnqueue() {
        queue.enqueue(3); 
        assertEquals(2, queue.getLength());
        assertEquals(1, queue.getHead().data);
        assertEquals(3, queue.getHead().next.data);
    }
    
    @Test
    public void testEnqueueWithCode() {
        queue.enqueue(7, 144); 
        assertEquals(2, queue.getLength());
        assertEquals(7, queue.getHead().next.data);
        assertEquals(144, queue.getHead().next.code);
    }

    @Test
    public void testDelete() {
        queue.add(2); //add 2 to back of list
        Integer deleted = queue.delete(); //delete 2 from back of list
        assertEquals(2, deleted); //value should be 2
        assertEquals(1, queue.getLength()); //length should now be 1 again
    }
    
    @Test
    public void testDequeue() {
        queue.enqueue(4); 
        Integer val = queue.dequeue();
        assertEquals(4, val);
        assertEquals(1, queue.getLength());
        assertEquals(1, queue.getHead().data);
    }
    
    @Test
    public void testIterator() {
        queue.enqueue(2); //adding elements 
        queue.enqueue(3);

        Iterator<Integer> it = queue.iterator(); //creates instance of iterator for queue
        assertTrue(it.hasNext()); //should be true, confirming Nodes exists
        assertEquals(1, it.next()); //should be equal
        assertEquals(2, it.next()); //should be equal
        assertEquals(3, it.next()); //should be equal
        assertFalse(it.hasNext()); //should be true, confirming no more Nodes
    }

    @Test
    public void testDescendingIterator() {
        queue.enqueue(2); //adding elements
        queue.enqueue(3);

        Iterator<Integer> it = queue.descendingIterator(); //creates instance
        assertTrue(it.hasNext()); // confirms Nodes exists
        assertEquals(3, it.next()); //last element
        assertEquals(2, it.next());
        assertEquals(1, it.next()); //first element
        assertFalse(it.hasNext()); //confirms no more Nodes exist
    }

    @Test
    public void testForEachLoop() {
        queue.enqueue(2); //adding elements
        queue.enqueue(3);

        int sum = 0;
        for (int val : queue) { //for-each loop uses iterator() automatically
            sum += val; 
        }
        assertEquals(6, sum);
    }

    @Test
    public void testDeleteSingleElement() {
        Integer deleted = queue.delete();
        assertEquals(1, deleted);
        assertEquals(0, queue.getLength());
        assertNull(queue.getHead());
    }
    
    
}
